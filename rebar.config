{erl_opts, [debug_info, warnings_as_errors]}.

%% The gRPC binding for A2A: `livery_grpc' carries the wire, `barrel_a2a'
%% carries the protocol. Both are libraries this package composes; it
%% adds no transport and no protocol of its own.
%%
%% It lives outside livery_grpc so a gRPC user does not take on an A2A
%% implementation, and outside barrel_a2a so an A2A user does not take
%% on gpb and a code generation step. See barrel_a2a's decision record
%% 0005.
%% `livery_grpc' 0.2.0 carries the `config' field of `service_spec()'
%% that this binding hands its agent through, so that is the floor.
%%
%% `livery' is declared here although livery_grpc is what needs it: the
%% hex packages for livery_grpc 0.2.0 and 0.2.1 list only `gpb' in their
%% requirements, so nothing pulls livery in and starting livery_grpc
%% fails with `livery.app: no such file or directory'. Drop this line
%% once a livery_grpc release carries its own requirements.
{deps, [
    {livery_grpc, "~> 0.2.1"},
    {livery, "~> 0.10.2"},
    {barrel_a2a, "~> 0.2.0"},
    {gpb, "5.0.0"}
]}.

{project_plugins, [
    {erlfmt, "1.7.0"},
    {rebar3_lint, "4.1.1"},
    {rebar3_gpb_plugin, "3.0.1"},
    rebar3_ex_doc
]}.

%% Compile proto/*.proto -> src/*_pb.erl (maps mode) before erl compile.
{gpb_opts, [
    {i, "proto"},
    %% Only proto/*.proto are compiled to modules. proto/google/rpc/*.proto
    %% are imports, inlined by gpb into the module that imports them.
    {recursive, false},
    %% Cross-package references (a2a.proto uses google.protobuf.Struct and
    %% friends) need use_packages, which qualifies every generated name.
    %% Renaming back to the base name keeps the Erlang atoms unqualified
    %% ('Task'), so a service binding stays `service => 'A2AService'`.
    use_packages,
    {rename, {msg_fqname, base_name}},
    {rename, {service_fqname, base_name}},
    {module_name_suffix, "_pb"},
    {o_erl, "src"},
    %% Maps mode generates no .hrl, so point this at src (which always
    %% exists) rather than an empty include/ dir that is absent on a
    %% fresh clone and would break the build.
    {o_hrl, "src"},
    {strings_as_binaries, true},
    {maps, true},
    {maps_unset_optional, omitted},
    type_specs,
    descriptor,
    {report_warnings, true}
]}.

{provider_hooks, [
    {pre, [
        {compile, {protobuf, compile}},
        {clean, {protobuf, clean}}
    ]}
]}.

{profiles, [
    {test, [{erl_opts, [nowarn_export_all]}]}
]}.

%% Generated `*_pb` modules are kept out of every style and static check:
%% erlfmt (exclude_files), elvis (ignore regex) and xref (xref_ignores).
%% They are produced from proto/ by the gpb plugin, not hand-edited.
{erlfmt, [
    write,
    {files, [
        "{src,test}/**/*.{hrl,erl,app.src}",
        "rebar.config"
    ]},
    {exclude_files, ["src/*_pb.erl"]}
]}.

{xref_ignores, [a2a_pb, a2a_status_pb]}.

%% `exports_not_used' is left out: the service callbacks are exported for
%% livery_grpc to dispatch to, so xref sees every one of them as unused.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{elvis, [
    #{
        dirs => ["src"],
        filter => "*.erl",
        ignore => ["_pb\\.erl$"],
        ruleset => erl_files,
        rules => [
            {elvis_style, no_macros, disable},
            {elvis_style, param_pattern_matching, disable},
            %% The codec dispatches on the proto message name.
            {elvis_style, invalid_dynamic_call, #{ignore => [livery_grpc_a2a_codec]}},
            {elvis_text_style, line_length, #{limit => 100}}
        ]
    }
]}.

{dialyzer, [
    {warnings, [unmatched_returns, error_handling, unknown]},
    {plt_extra_apps, [livery, livery_grpc, gpb, barrel_a2a, crypto, ssl, public_key]}
]}.
